NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The absolute origin, used for canonical URLs, the Open Graph image, robots.txt
# and sitemap.xml (ADR-0007). Optional: on Vercel it falls back to
# VERCEL_PROJECT_PRODUCTION_URL, and locally to http://localhost:7777. Set it
# once a custom domain exists.
NEXT_PUBLIC_SITE_URL=

# Published on /privacy as the address for data access and deletion requests
# (LGPD / GDPR). Optional: unset, the page points at the repository's issues
# instead. Set it to a real inbox before inviting strangers in.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Local Supabase only (supabase/config.toml reads these via env()) ---------
# Google OAuth is the only sign-in provider (ADR-0003). To run the auth flow
# against a local stack, create a Google OAuth client in the Google Cloud
# Console and paste its credentials here; the authorized redirect URI is
# http://127.0.0.1:54321/auth/v1/callback locally, and
# https://<project-ref>.supabase.co/auth/v1/callback in the cloud. In a hosted
# project these are set in Supabase → Authentication → Providers → Google
# instead, not in this file.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
